{
  "name": "cf-pages-shortlink-admin",
  "version": "2.0.0",
  "private": true,
  "description": "Cloudflare Pages + D1 短链服务，含管理后台（登录、链接管理、点击统计、管理员角色、审计日志）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "tail": "wrangler pages deployment tail",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply shortlink --local",
    "db:remote": "wrangler d1 migrations apply shortlink --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
